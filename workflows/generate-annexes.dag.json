{
  "$schema": "https://antigravity.ai/schemas/workflow.v1.json",
  "name": "generate-annexes",
  "displayName": "Contract Technical Annexes Generation DAG Pipeline",
  "description": "Multi-agent staged DAG pipeline transforming the pre-sales engineering dossier (DOSSIE_TECNICO_PRE_PROPOSTA.md) into the 5 binding technical annexes with cross-consistency auditing.",
  "version": "1.0.0",
  "constraints": {
    "prohibit_slides": true,
    "prohibit_presentation_decks": true,
    "prohibit_vague_scope": true,
    "mandate_deemed_acceptance_5_days": true,
    "mandate_binary_defect_classification": true,
    "mandate_schedule_freeze": true,
    "mandate_warranty_vs_ams_boundary": true
  },
  "stages": [
    {
      "id": "stage0_ingestion_normalization",
      "name": "Ingestion & Contract Baseline Normalization",
      "agent": "agents/ingestion-normalizer.json",
      "depends_on": [],
      "inputs": ["dossier_path", "contract_params"],
      "outputs": ["normalized_project_baseline.json"],
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    },
    {
      "id": "stage1_sow_architecture",
      "name": "SOW Architecture & Noun-based Scope Formulation",
      "agent": "agents/sow-architect.json",
      "depends_on": ["stage0_ingestion_normalization"],
      "inputs": ["normalized_project_baseline.json"],
      "outputs": ["ANEXO_1_SOW.md"],
      "template": "templates/ANEXO_1_SOW.template.md",
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    },
    {
      "id": "stage2_client_governance",
      "name": "Client Governance & Bilateral Obligations Specification",
      "agent": "agents/client-governance-drafter.json",
      "depends_on": ["stage0_ingestion_normalization"],
      "inputs": ["normalized_project_baseline.json"],
      "outputs": ["ANEXO_2_RACI_PRE_REQUISITOS.md"],
      "template": "templates/ANEXO_2_RACI_PRE_REQUISITOS.template.md",
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    },
    {
      "id": "stage3_acceptance_policy",
      "name": "Acceptance Protocol & Binary Defect Classification",
      "agent": "agents/acceptance-policy-drafter.json",
      "depends_on": ["stage0_ingestion_normalization", "stage1_sow_architecture"],
      "inputs": ["normalized_project_baseline.json", "ANEXO_1_SOW.md"],
      "outputs": ["ANEXO_3_PROTOCOLO_HOMOLOGACAO.md"],
      "template": "templates/ANEXO_3_PROTOCOLO_HOMOLOGACAO.template.md",
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    },
    {
      "id": "stage4_risk_maintenance",
      "name": "Change Request Protocol & Warranty/SLA Demarcation",
      "agent": "agents/risk-maintenance-drafter.json",
      "depends_on": ["stage0_ingestion_normalization", "stage1_sow_architecture", "stage3_acceptance_policy"],
      "inputs": ["normalized_project_baseline.json", "ANEXO_1_SOW.md", "ANEXO_3_PROTOCOLO_HOMOLOGACAO.md"],
      "outputs": ["ANEXO_4_CHANGE_REQUEST.md", "ANEXO_5_GARANTIA_SLA.md"],
      "templates": [
        "templates/ANEXO_4_CHANGE_REQUEST.template.md",
        "templates/ANEXO_5_GARANTIA_SLA.template.md"
      ],
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    },
    {
      "id": "stage5_cross_consistency_audit",
      "name": "Cross-Consistency & Legal-Technical Compliance Audit",
      "agent": "agents/cross-auditor.json",
      "depends_on": [
        "stage1_sow_architecture",
        "stage2_client_governance",
        "stage3_acceptance_policy",
        "stage4_risk_maintenance"
      ],
      "inputs": [
        "normalized_project_baseline.json",
        "ANEXO_1_SOW.md",
        "ANEXO_2_RACI_PRE_REQUISITOS.md",
        "ANEXO_3_PROTOCOLO_HOMOLOGACAO.md",
        "ANEXO_4_CHANGE_REQUEST.md",
        "ANEXO_5_GARANTIA_SLA.md"
      ],
      "outputs": ["ANEXO_TECNICO_MESTRE_CONTRATO.md"],
      "rules": [
        "rules/contract-engineering-standards.md",
        "rules/legal-technical-boundaries.md"
      ]
    }
  ]
}
