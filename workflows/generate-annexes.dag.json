{
  "$schema": "https://antigravity.ai/schemas/dag-workflow.v1.json",
  "id": "generate-technical-annexes-workflow",
  "name": "Generate Technical Contract Annexes Pipeline",
  "version": "1.1.0",
  "nodes": [
    {
      "id": "step_1_ingestion",
      "agent": "agents/ingestion-normalizer.md",
      "inputs": {
        "dossier": "{{args.dossier_path}}",
        "params": "{{args.contract_params}}"
      },
      "outputs": ["normalized_project_baseline.json"]
    },
    {
      "id": "step_2a_sow",
      "agent": "agents/sow-architect.md",
      "depends_on": ["step_1_ingestion"],
      "inputs": {
        "baseline": "normalized_project_baseline.json",
        "template": "templates/ANEXO_1_SOW.template.md"
      },
      "outputs": ["{{args.output_dir}}/ANEXO_1_SOW.md"]
    },
    {
      "id": "step_2b_raci",
      "agent": "agents/client-governance-drafter.md",
      "depends_on": ["step_1_ingestion"],
      "inputs": {
        "baseline": "normalized_project_baseline.json",
        "template": "templates/ANEXO_2_RACI_PRE_REQUISITOS.template.md"
      },
      "outputs": ["{{args.output_dir}}/ANEXO_2_RACI_PRE_REQUISITOS.md"]
    },
    {
      "id": "step_2c_acceptance",
      "agent": "agents/acceptance-policy-drafter.md",
      "depends_on": ["step_1_ingestion"],
      "inputs": {
        "baseline": "normalized_project_baseline.json",
        "template": "templates/ANEXO_3_PROTOCOLO_HOMOLOGACAO.template.md"
      },
      "outputs": ["{{args.output_dir}}/ANEXO_3_PROTOCOLO_HOMOLOGACAO.md"]
    },
    {
      "id": "step_2d_risk_sla",
      "agent": "agents/risk-maintenance-drafter.md",
      "depends_on": ["step_1_ingestion"],
      "inputs": {
        "baseline": "normalized_project_baseline.json",
        "template_cr": "templates/ANEXO_4_CHANGE_REQUEST.template.md",
        "template_sla": "templates/ANEXO_5_GARANTIA_SLA.template.md"
      },
      "outputs": [
        "{{args.output_dir}}/ANEXO_4_CHANGE_REQUEST.md",
        "{{args.output_dir}}/ANEXO_5_GARANTIA_SLA.md"
      ]
    },
    {
      "id": "step_3_audit_and_bundle",
      "agent": "agents/cross-auditor.md",
      "depends_on": [
        "step_2a_sow",
        "step_2b_raci",
        "step_2c_acceptance",
        "step_2d_risk_sla"
      ],
      "inputs": {
        "baseline": "normalized_project_baseline.json",
        "annex_1": "{{args.output_dir}}/ANEXO_1_SOW.md",
        "annex_2": "{{args.output_dir}}/ANEXO_2_RACI_PRE_REQUISITOS.md",
        "annex_3": "{{args.output_dir}}/ANEXO_3_PROTOCOLO_HOMOLOGACAO.md",
        "annex_4": "{{args.output_dir}}/ANEXO_4_CHANGE_REQUEST.md",
        "annex_5": "{{args.output_dir}}/ANEXO_5_GARANTIA_SLA.md"
      },
      "outputs": ["{{args.output_dir}}/ANEXO_TECNICO_MESTRE_CONTRATO.md"]
    }
  ]
}
